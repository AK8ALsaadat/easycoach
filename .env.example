# Development only: set LOCAL_DB_PATH to run `npm run dev` on an embedded PostgreSQL with
# synthetic accounts (loopback hosts only). Ignored by production builds; leave unset on Vercel.
LOCAL_DB_PATH=./data/easycoach
# Supabase project (production): apply supabase/migrations/*.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required on hosted deployments for private image signing/cleanup and portal
# exchange throttling. Server-only; tenant reads/writes still use scoped RLS RPCs.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct SQL tooling, transaction pooler (:6543), never exposed to the browser.
DATABASE_URL=
APP_URL=http://127.0.0.1:3200
# UUID from auth.users for the sole platform support inbox owner (server-side only).
SUPPORT_OWNER_USER_ID=

# Show "Continue with Google" after enabling the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=false

# Paylink: the platform merchant collects EasyCoach subscriptions from coaches.
# Never use coach merchant keys. Live: https://restapi.paylink.sa
PAYLINK_BASE_URL=https://restpilot.paylink.sa
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
# Required webhook Authorization: Bearer <secret>. Server-side only.
PAYLINK_WEBHOOK_SECRET=
# Configure ec_config.provider_verified and actual tax treatment before billing.
# Hosted one-month payment only. No recurring card setup or automatic renewal.

# >=32 random characters; protects /api/maintenance/subscriptions.
CRON_SECRET=
# Campaign windows, reference-price approval and actual VAT treatment are held in
# public.ec_config. The 14-day card-less trial campaign is open until closed by the operator.
# No separate messaging provider exists yet; reminders remain in ec_email_outbox.
