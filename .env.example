# Development only: set LOCAL_DB_PATH to run `npm run dev` on an embedded PostgreSQL with
# synthetic accounts (loopback hosts only). Ignored by production builds; leave unset on Vercel.
LOCAL_DB_PATH=./data/easycoach
# Supabase project (production): apply supabase/migrations/*.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required on hosted deployments for private image signing/cleanup and portal
# exchange throttling. Server-only; tenant reads/writes still use scoped RLS RPCs.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct SQL tooling, transaction pooler (:6543), never exposed to the browser.
DATABASE_URL=
APP_URL=http://127.0.0.1:3200
# UUID from auth.users for the sole platform support inbox owner (server-side only).
SUPPORT_OWNER_USER_ID=

# Show "Continue with Google" after enabling the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=false

# Paylink (API v2) online subscription payments. Each coach links their own Paylink
# account from Settings (money goes straight to them). Test: https://restpilot.paylink.sa
# Live: https://restapi.paylink.sa. Keys live only here or sealed in the database.
PAYLINK_BASE_URL=https://restpilot.paylink.sa
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Seals each coach's Paylink keys. Changing it disconnects every linked coach.
PAYLINK_CREDENTIALS_KEY=
# Optional: the platform owner's own coach account, from env instead of the settings form.
PAYLINK_ENV_COACH_ID=
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
# Value expected in the webhook's "Authorization: Bearer <secret>" header for that account.
PAYLINK_WEBHOOK_SECRET=
