# local: file-backed PostgreSQL preview with synthetic accounts; loopback hosts only.
APP_MODE=local
LOCAL_DB_PATH=./data/easycoach
# supabase: configure your own project and apply supabase/migrations/*.sql.
# APP_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional admin-only tooling; the application never uses this to read coach data.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only credential for the reserved /demo identity. Provision with scripts/provision-demo.mjs.
DEMO_AUTH_PASSWORD=
# Optional direct SQL tooling, transaction pooler (:6543), never exposed to the browser.
DATABASE_URL=
APP_URL=http://127.0.0.1:3200
